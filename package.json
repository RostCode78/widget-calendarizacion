{
  "name": "calendarizacion",
  "productName": "Calendarizacion",
  "version": "1.0.0",
  "private": true,
  "description": "Widget de escritorio de Rost: tareas de Notion y eventos del calendario.",
  "author": "Rost",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test",
    "instalador": "vite build && electron-builder --win"
  },
  "dependencies": {
    "koffi": "^3.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.rost.calendarizacion",
    "productName": "Calendarizacion",
    "files": [
      "dist/**",
      "electron/**",
      "!electron/**/*.test.js",
      "package.json"
    ],
    "directories": {
      "output": "instalador"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Calendarizacion",
      "createDesktopShortcut": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
